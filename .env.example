# Configuration for compose.yaml and scripts/download-all.sh. Copy to .env (or run `scripts/docker.sh init`,
# which also generates the token). .env is not committed.

# Bearer token clients must send, at least 16 characters: openssl rand -hex 32
# "none" disables authentication: every request is accepted (only in a trusted network)
GB10_ASSETS_TOKEN=

# Model weights on the host, mounted at /models. Relative paths are relative to the repo directory.
MODELS_DIR=./models
# Job inputs and results on the host, mounted at /jobs
JOBS_DIR=./jobs

# Host port of the HTTP server
GB10_ASSETS_PORT=8750

# Image name for build, push and pull (Docker Hub: <user>/<repo>)
GB10_ASSETS_IMAGE=stefanmenne/gb10-assets
GB10_ASSETS_TAG=latest

# Host user the container runs as (owner of the files in MODELS_DIR and JOBS_DIR): id -u / id -g
GB10_UID=1000
GB10_GID=1000

# Only for gated models
HF_TOKEN=

# Queue tuning (see src/gb10_assets/server/config.py)
WORKER_IDLE_S=0
MEMORY_WAIT_S=600
WORKER_READY_S=1800
JOB_TTL_H=24
