# Configuration for compose.yaml and the scripts in scripts/. Copy to .env (or run `scripts/docker.sh init`,
# which also generates the token). .env is not committed.

# Bearer token clients must send, at least 16 characters: openssl rand -hex 32
# "none" disables authentication: every request is accepted (only in a trusted network)
GB10_ASSETS_TOKEN=

# Installed tools on the host (per tool its environment and model weights, ~200 GB for all), mounted at
# /installed. Relative paths are relative to the repo directory.
INSTALL_DIR=./installed
# Job inputs and results on the host, mounted at /jobs
JOBS_DIR=./jobs

# Host port of the HTTP server
GB10_ASSETS_PORT=8750

# Name of the locally built image
GB10_ASSETS_IMAGE=stefanmenne/gb10-assets
GB10_ASSETS_TAG=latest

# Host user the container runs as (owner of the files in INSTALL_DIR and JOBS_DIR): id -u / id -g
GB10_UID=1000
GB10_GID=1000

# Only for gated models; only `scripts/docker.sh install|update` use it, the running server does not get it
HF_TOKEN=

# Blender tool: 1 = jobs may run own Python code in Blender (in the container, as GB10_UID, with access to
# INSTALL_DIR, JOBS_DIR, the GPU and the network), 0 = only the bundled scripts
BLENDER_CODE=1

# Queue tuning (see src/gb10_assets/server/config.py)
WORKER_IDLE_S=0
MEMORY_WAIT_S=600
WORKER_READY_S=1800
JOB_TTL_H=24
